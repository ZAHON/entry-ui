{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "lib",
    "noEmit": false,
  },
  "exclude": [
    "**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/routes/**",
    "src/root.tsx",
    "src/entry.ssr.tsx",
    "vite.config.ts",
    "vitest.setup.ts",
  ],
}
